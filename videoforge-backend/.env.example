# =============================================================================
# VideoForge — AI Video Generation Environment Configuration
# =============================================================================

# App
APP_NAME=VideoForge
DEBUG=false
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1

# Storage
PROJECTS_DIR=./projects
STORAGE_DIR=./storage
COMPOSE_DIR=./compose

# Database
DATABASE_URL=postgresql://videoforge:videoforge@localhost:5432/videoforge

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ElevenLabs
ELEVENLABS_API_KEY=your-elevenlabs-key-here
ELEVENLABS_VOICE_ID=your-default-voice-id

# Local TTS Servers (from your ElevenLabs folder)
ELEVENLABS_STYL_TTS_URL=http://localhost:8000
ELEVENLABS_SEEDVC_URL=http://localhost:8001
ELEVENLABS_MAA_URL=http://localhost:8002
AUDIO_SERVICE_API_KEY=12345

# HyperFrames
HYPERFRAMES_API_URL=http://localhost:3001
HYPERFRAMES_API_KEY=your-hyperframes-key

# Presenton
PRESENTON_URL=http://localhost:3002
PRESENTON_API_KEY=your-presenton-key

# Video Settings
DEFAULT_WIDTH=1920
DEFAULT_HEIGHT=1080
DEFAULT_FPS=30
DEFAULT_WORDS_PER_MINUTE=150
